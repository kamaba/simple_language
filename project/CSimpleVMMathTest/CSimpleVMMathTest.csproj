<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\source\Front\SimpleLanguageFront.csproj" />
  </ItemGroup>

  <!-- 用 CMake 构建 C VM DLL（唯一 DLL 来源：csimple_lang\build\Debug\bin\csimple_lang_dll.dll，
       Program.cs P/Invoke 加载的就是它；VS 内构建也走这里，保证断点行号与加载的 PDB 一致）。
       必须统一使用 build\Debug 这棵 Ninja/clang 树（与命令行开发同一棵树）；
       不要在顶层 build\ 生成 VS 树：两棵树的 DLL 输出目录相同，会互相覆盖，
       导致 P/Invoke 加载到旧版 DLL，出现字符串错乱（Phase 2 错配）等问题。 -->
  <Target Name="BuildCVM" BeforeTargets="Build">
    <PropertyGroup>
      <CVMRoot>$(MSBuildThisFileDirectory)..\..\..\csimple_lang</CVMRoot>
      <CVMBuild>$(CVMRoot)\build\Debug</CVMBuild>
    </PropertyGroup>
    <!-- 仅在构建树不存在时才 configure（参数与现有 build\Debug 树一致：Ninja + clang） -->
    <Exec Condition="!Exists('$(CVMBuild)\CMakeCache.txt')"
          Command="cmake -B &quot;$(CVMBuild)&quot; -S &quot;$(CVMRoot)&quot; -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_C_COMPILER=&quot;C:/Program Files/LLVM/bin/clang.exe&quot;" />
    <Exec Command="cmake --build &quot;$(CVMBuild)&quot; --target csimple_lang_dll" />
  </Target>

</Project>
