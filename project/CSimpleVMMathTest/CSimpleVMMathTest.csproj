<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\source\Front\SimpleLanguageFront.csproj" />
  </ItemGroup>

  <!-- 用 CMake 构建 C VM DLL（唯一 DLL 来源：csimple_lang\build\Debug\bin\csimple_lang_dll.dll，
       Program.cs P/Invoke 加载的就是它；VS 内构建也走这里，保证断点行号与加载的 PDB 一致）。
       必须统一使用 build\Debug 这棵 Ninja/clang 树（与命令行开发同一棵树）；
       不要在顶层 build\ 生成 VS 树：两棵树的 DLL 输出目录相同，会互相覆盖，
       导致 P/Invoke 加载到旧版 DLL，出现字符串错乱（Phase 2 错配）等问题。 -->
  <Target Name="BuildCVM" BeforeTargets="Build">
    <PropertyGroup>
      <CVMRoot>$(MSBuildThisFileDirectory)..\..\..\csimple_lang</CVMRoot>
      <CVMBuild>$(CVMRoot)\build\Debug</CVMBuild>
      <!-- ninja 路径：NINJA_PATH 环境变量优先（CMakePresets.json 同款约定），
           未设置时回退到本机 winget 安装路径（CMake 探测不到 winget 装的 ninja） -->
      <CVMNinja Condition="'$(NINJA_PATH)' != ''">$(NINJA_PATH)</CVMNinja>
      <CVMNinja Condition="'$(NINJA_PATH)' == ''">C:/Users/dingo/AppData/Local/Microsoft/WinGet/Packages/Ninja-build.Ninja_Microsoft.Winget.Source_8wekyb3d8bbwe/ninja.exe</CVMNinja>
    </PropertyGroup>
    <!-- 缓存健康检测：CMakeCache.txt 存在，且其中记录着本工程要用的 ninja 和 clang 路径才算可用。
         用 ReadAllText().Contains() 判断，只把布尔结果带进 MSBuild 条件（ReadAllLines 返回
         数组不受支持；缓存全文也不进属性，避免分号等字符被当列表分隔符）。
         IDE 的 CMake 插件按 CMakePresets.json 重新 configure 时若 NINJA_PATH 未设置，
         会把缓存里的 CMAKE_MAKE_PROGRAM 写成空值并中途失败，留下半损坏的缓存
         （文件存在但 cmake 构建时报 no such file or directory / build tool execution failed） -->
    <PropertyGroup Condition="Exists('$(CVMBuild)\CMakeCache.txt')">
      <CVMCacheHasNinja Condition="$([System.IO.File]::ReadAllText('$(CVMBuild)\CMakeCache.txt').Contains('$(CVMNinja)'))">true</CVMCacheHasNinja>
      <CVMCacheHasClang Condition="$([System.IO.File]::ReadAllText('$(CVMBuild)\CMakeCache.txt').Contains('C:/Program Files/LLVM/bin/clang.exe'))">true</CVMCacheHasClang>
      <CVMCacheUsable Condition="'$(CVMCacheHasNinja)' == 'true' and '$(CVMCacheHasClang)' == 'true'">true</CVMCacheUsable>
    </PropertyGroup>
    <!-- 缓存被写坏或被换成别的工具链时，先删旧缓存再 configure，
         避免 cmake 因编译器与缓存记录不一致而拒绝覆盖、直接报错 -->
    <Delete Files="$(CVMBuild)\CMakeCache.txt"
            Condition="'$(CVMCacheUsable)' != 'true' and Exists('$(CVMBuild)\CMakeCache.txt')" />
    <!-- 仅在构建树不存在或缓存被写坏时才 configure（参数与现有 build\Debug 树一致：Ninja + clang）。
         注：Windows-Clang 平台模块强制要求 RC 编译器（即使项目无 .rc 文件），
         必须显式指定 llvm-rc，否则全新构建树 configure 会失败 -->
    <Exec Condition="'$(CVMCacheUsable)' != 'true'"
          Command="cmake -B &quot;$(CVMBuild)&quot; -S &quot;$(CVMRoot)&quot; -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_C_COMPILER=&quot;C:/Program Files/LLVM/bin/clang.exe&quot; -DCMAKE_RC_COMPILER=&quot;C:/Program Files/LLVM/bin/llvm-rc.exe&quot; -DCMAKE_MAKE_PROGRAM=&quot;$(CVMNinja)&quot;" />
    <!-- 同时构建 csimple_lang.exe（Program.cs Step3 需要它存在）与 csimple_lang_dll.dll
         （Debug 模式 P/Invoke 进程内加载，可附加 C 调试器） -->
    <Exec Command="cmake --build &quot;$(CVMBuild)&quot; --target csimple_lang csimple_lang_dll" />
  </Target>

</Project>
