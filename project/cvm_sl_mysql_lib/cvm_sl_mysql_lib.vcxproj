  <PropertyGroup Label="UserMacros" />
  <!-- MySQL Connector/C（官方发行包，x64）已随库源码一起放在
       source\Front\Lib\SLMysql\cvm_sl_mysql_lib\mysqlclient。
       静态链接 lib\vs14\mysqlclient.lib 而非动态 libmysql.dll：这样本工程产出
       的 sl_mysql_lib.dll 自包含，导出流水线只需拷贝这一个 DLL。 -->
  <PropertyGroup>
    <MySqlClientRoot>$(ProjectDir)..\..\source\Front\Lib\SLMysql\cvm_sl_mysql_lib\mysqlclient</MySqlClientRoot>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>_DEBUG;_WINDOWS;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(MySqlClientRoot)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(MySqlClientRoot)\lib\vs14;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>mysqlclient.lib;ws2_32.lib;crypt32.lib;secur32.lib;advapi32.lib;user32.lib;netapi32.lib;shlwapi.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- 官方静态库按 /MD Release 构建（DEFAULTLIB:MSVCRT），Debug 下会与
           调试 CRT 冲突触发 LNK4098；两者同为 DLL CRT 兄弟版本，忽略 MSVCRT
           由 MSVCRTD 统一提供符号。 -->
      <IgnoreSpecificDefaultLibraries>MSVCRT;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
    </Link>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>NDEBUG;_WINDOWS;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(MySqlClientRoot)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(MySqlClientRoot)\lib\vs14;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>mysqlclient.lib;ws2_32.lib;crypt32.lib;secur32.lib;advapi32.lib;user32.lib;netapi32.lib;shlwapi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\..\source\Front\Lib\SLMysql\cvm_sl_mysql_lib\sl_mysql_lib.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\..\source\Front\Lib\SLMysql\cvm_sl_mysql_lib\vm_sl_mysql.h" />
  </ItemGroup>
