<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\source\Front\SimpleLanguageFront.csproj" />
  </ItemGroup>

  <!-- C VM 改用 VS 原生工程关联构建（不再调用 cmake/ps1）：
       引用解决方案中手工维护的 csimple_lang_lib.vcxproj，
       Debug|x64 产出 csimple_lang_dll.dll 到 csimple_lang\build\Debug\bin\，
       正是本工程 P/Invoke（cli_main）加载的位置。
       条件限定 MSBuildRuntimeType=Full：VS / MSBuild.exe 才驱动 vcxproj 构建；
       dotnet CLI（Core）无 VC targets，跳过引用，直接复用已有 DLL。 -->
  <ItemGroup Condition="'$(MSBuildRuntimeType)' == 'Full'">
    <ProjectReference Include="..\..\..\csimple_lang\project\vs\vm_lib\csimple_lang_lib.vcxproj">
      <Project>{1de0cc1e-2c43-457c-9b9c-860c54ffa58c}</Project>
      <Name>csimple_lang_lib</Name>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworks>true</SkipGetTargetFrameworks>
      <SetPlatform>Platform=x64</SetPlatform>
    </ProjectReference>
  </ItemGroup>

</Project>
