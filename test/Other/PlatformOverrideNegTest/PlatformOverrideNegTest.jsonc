{
  "project":
  {
    "name": "PlatformOverrideNegTest",
    "desc": "Negative case: illegal platform.override keys -> Error 20036 + suggestions + compile aborted (Y group)",
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "PlatformOverrideNegTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "struct": [
      { "namespace": "PlatformOverrideNegTest", "children": [] }
  ],
  "export": {
    "moduleName": "PlatformOverrideNegTest",
    "outputDir": "F:\\project\\lang\\simple_language\\out\\export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  },
  "platform": {
    "override": {
      "cpu.avxxx": true,
      "cp.avx2": true,
      "avxxx": true
    }
  }
}
