{
  "project":
  {
    "name": "PlatformNegTest",
    "desc": "Negative case: illegal platform.require values -> Error 20036 + compile aborted (S group)",
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "PlatformNegTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "struct": [
      { "namespace": "PlatformNegTest", "children": [] }
  ],
  "export": {
    "moduleName": "PlatformNegTest",
    "outputDir": "F:\\project\\lang\\simple_language\\out\\export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  },
  "platform": {
    "require": {
      "os":     { "any": [ "linuxx", "window" ] },
      "arch":   { "any": [ "arm65", "arm64" ] },
      "cpu":    { "all": [ "sse5" ] },
      "render": { "api": { "any": [ "vulkn", "d3d12" ] } }
    }
  }
}
