{
  "project":
  {
    "name": "SpecialTest",
    "desc": "Special test tests - AOT native compile (merged from AOTTest), C#/Java/JS interop",  
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "AOTTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "AOTStructTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "AOTGPUTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "FFITest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "CSharpTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "CSharpTest2.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "CSharpTest3.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "JavaTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ProcessTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "AOT.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "MapTest.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "FileTest.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "CsvTest.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "DirectoryTest.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "ConsoleTest.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "DateTimeTest.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "LinkedListTest.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "Sqlite3Test.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 },
      { "path": "ModuleGlobalTest.sl", "group": "core", "tag": "base", "ignore": true, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console",
      "Std.IO.File"
    ],
    "replace": {
      "DEBUG": "true"
    }
  },
  "data": {
    "var1": 12,
    "arrvar1": [1, 2, 3, 4, 5],
    "vardata2": {
      "a": 10,
      "b": 20.1
    }
  },
  // 插件声明（PLUGIN_SYSTEM_DESIGN.md §0.1/§4.2）：key=插件 id；lib 对象由
  // PluginLibExportManager 四级回退（lib/windows-x64/ → lib/windows/ → …）
  // 求值平台库并拷到 out/export/ProjectTest/plugins/echo/，module.json 记
  // 相对包路径（lib/libs）；CVM 侧登记不加载（惰性激活）。
  "plugins": {
    "echo": {
      "name": "echo_test_plugin",
      "version": "0.1.0",
      "path": "simple_language_plugins/echo",
      "enabled": true,
      "abi": 1,
      "lib": { "dir": "lib", "select": "auto" },
      // 插件级平台条件短写（§4.1/§4.3：复用 SLRequirementExpr 语法，String=eq 简写）：
      // 编译为条件 AST 随 module.json 导出，CVM 装配期 sl_require_check 求值
      //（先模块后插件），未通过按 onUnavailable 三态降级（disable/warn/error）。
      "platform": { "os": "windows", "arch": "x86_64" },
      "onUnavailable": "warn",
      "capabilities": [
        { "type": "systemCall", "name": "echo" }
      ]
    },
    // csharp_mono（P1-e，MONO_INTEGRATION_DESIGN.md §4.3 / PLUGIN_SYSTEM_DESIGN.md §10.1）：
    // lib 用字符串直给（相对包路径，CVM 侧基准 = module.json 所在目录拼
    // sl_plugin_resolver_join_lib_path），从 simple_language_plugins 原位加载——不走
    // PluginLibExportManager 拷贝（其 TopDirectoryOnly 不递归 lib/mono/4.5/
    // BCL 目录树，对象形态会缺 BCL）；原位同目录天然齐备 mono-2.0-sgen.dll + BCL。
    // prefix 必须显式 = 实际符号前缀 "sl_csharp_mono_"（plugin.jsonc entry.prefix），
    // 缺省 id+"_" 会解析不到六件套符号。测试程序集 SLCSharpTestLib.dll 部署在
    // 插件 dll 同目录，asm 元参用裸文件名经 assemblies_path 兜底命中。
    "csharp_mono": {
      "name": "csharp_runtime_use_mono_engine",
      "version": "0.1.0",
      "path": "simple_language_plugins/csharp_mono",
      "enabled": true,
      "abi": 1,
      "prefix": "sl_csharp_mono_",
      "lib": "../../../../simple_language_plugins/csharp_mono/cvm/lib/windows-x64/cvm_csharp_mono.dll",
      // 额外引用（references）：块内 C# 引用的预编译 managed 程序集——
      // 导出期 Front 拷入插件 libDir（编译期 csc /r: 引用 + 运行期 mono
      // assemblies_path 从插件 dll 同目录裸名解析）+ 随 Build 请求下发路径。
      // 相对路径按本 jsonc 所在目录解析（同 lib/path 口径）。
      // 注意：System.Windows.Forms / System.Drawing 不能加进来——csc 默认
      // csc.rsp 已引用 Framework 同名程序集（同标识 4.0.0.0），显式 /r: mono
      // 版会 CS1703 重复导入；编译期用 csc.rsp 默认引用，运行期 mono 经
      // assemblies_path 从插件 BCL 树（lib/mono/4.5/，已补齐 mono 6.12.0.206
      // 的 SWF/Drawing 等）解析加载，见 CSharpTest3.sl。
      "references": [ "CsExtra/ExtraMathLib.dll" ],
      // 额外源码（sources）：与全部 @csharp_mono(){} 块体同批合并编译进
      // SLAtSign.dll 的 .cs 文件——导出期 Front 读文件内容随 Build 请求
      // 下发，块内头区 using 其命名空间即可调用其中类型（无需重编 dll）。
      "sources": [ "CsExtra/SlExtraUtil.cs" ],
      "platform": { "os": "windows", "arch": "x86_64" },
      "onUnavailable": "warn",
      "capabilities": [
        { "type": "systemCall", "name": "csharp" }
      ]
    },
    // java_hotspot（HOTSPOT_JNI_INTEGRATION_DESIGN.md）：lib 用字符串直给原位
    // 相对路径（同 csharp_mono 口径，不走 PluginLibExportManager 拷贝）——
    // 插件 dll 同目录树天然齐备 ..\..\runtime\jvm.dll 与 SLAtSign.jar（C 侧
    // SLJH_JVM_RELATIVE/SLJH_JAR_RELATIVE 相对插件 dll 定位）。prefix 必须显式
    // = "sl_java_hotspot_"（plugin.jsonc entry.prefix）。块体 .java 源码由
    // SLLabelBuilder 经 javac --release 17 编译部署到 <libDir>\classes\，
    // 运行期 bridge 以 SLAtSign 组前缀 + 裸类名 loadClass。本机无 JDK 时
    // Build 返回 notFound/kind=notFound 降级（onUnavailable=warn 不阻断）。
    "java_hotspot": {
      "name": "java_runtime_use_hotspot_engine",
      "version": "0.1.0",
      "path": "simple_language_plugins/java_hotspot",
      "enabled": true,
      "abi": 1,
      "prefix": "sl_java_hotspot_",
      "lib": "../../../../simple_language_plugins/java_hotspot/cvm/lib/windows-x64/cvm_java_hotspot.dll",
      "platform": { "os": "windows", "arch": "x86_64" },
      "onUnavailable": "warn",
      "capabilities": [
        { "type": "signLabel", "name": "signLabel" }
      ]
    }
  },
  // 插件系统方法（PLUGIN_SYSTEM_DESIGN.md §10.1）：cvmFunction = "plugin:<capability name>"，
  // 装配期 CVM 经 plugin registry 隐式 load+enter 插件 echo 后直注册 echo_exec
  //（sl_runtime_assembly_register_plugin_system_call）。
  // 注意：returnType/params 类型名须用 ResolveTypeName 支持的写法（float64 等，"double" 不识别）。
  "systemCalls": [
    { "name": "Echo", "returnType": "Float64", "params": ["Float64"], "isVariadic": false, "cvmFunction": "plugin:echo" },
    // @<tag>(){} 内联块哨兵（调用方工程须可见，Meta 层 SystemMethodCallDeclarationRegistry
    // 只装载当前工程 systemCalls；Core.jsonc 那份供 Core 模块自编译时使用）。
    // IRCall.TryParseAtSignLabelCall 拦截改写为 CallAtSignLabel(124)：首参 entryIndex
    // 常量不发射，CVM 经模块 atSignLabel[] 绑定 entryIndex 走插件 labelExec capability。
    { "name": "AtSignLabelCall",     "returnType": "Int32", "params": ["Int32"], "isVariadic": true,  "cvmFunction": "atsign:label" },
    { "name": "AtSignLabelCallVoid", "returnType": "Void",  "params": ["Int32"], "isVariadic": true,  "cvmFunction": "atsign:label" },
    // csharp_mono（P1-e）：SL 调 C# 静态方法——CSharpCallVoid/Int/String 三条声明已
    // 移到插件 refModule（CSharpMono 模块的 CSharpMono.jsonc systemCalls 段，带
    // "class": "SLang.Plugin.CSharpMono" 归属标记），经 plugins.csharp_mono 的
    // plugin.jsonc refModule 段在 RefModule 阶段自动加载，无需在此重复声明。
    // 栈协议不变（cvm_csharp_mono.c）：前 4 参 = asm/ns/class/method（String），
    // 第 5 参 = ret_kind（整型变参：0=void/1=int/2=string），其后为 C# 实参——
    // 变参按实际类型压栈不矫正（IRCall.cs ParseSystemCall 只矫正固定形参）。
    // 调用侧形如 SLang.Plugin.CSharpMono.CSharpCallInt(asm, ns, cls, m, 1, 40, 2)。
  ],
  "dllImports": [
    {
      "path": "../../source/CLangdll/x64/Debug/CLangdll.dll", "name": "CLangdll", "alias": "CLangdll", "static": "CLangdll",
      "functions": [
        { "name": "libaddfunc", "symbol": "simplelanguage_addtest", "sig": "i32,i32->i32" }
      ]
    },
    { "path": "../../source/CLangdll/x64/Debug/CLangdll.dll", "name": "CLangdll", "alias": "cl" }
  ],
  "references": [
    { "path": "../../out/export/Core", "uuid":"123123123213", "name": "Core.module.json" },
    { "path": "../../out/export/Std", "uuid":"456456456456", "name": "Std.module.json" }
  ],
  "struct": [
  ],
  "export": {
    "moduleName": "SpecialTest",
    "outputDir": "..\\..\\out\\export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  }
}
