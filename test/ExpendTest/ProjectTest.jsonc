{
  "project":
  {
    "name": "ProjectTest",
    "desc": "Base test project - runs all BaseTest .sl test files",
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "ListTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "MapTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "FileTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "DirectoryTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "ConsoleTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "DateTimeTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 },
      { "path": "LinkedListTest.sl", "group": "core", "tag": "base", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console",
      "Std.IO.File"
    ],
    "replace": {
      "DEBUG": "true"
    }
  },
  "data": {
    "var1": 12,
    "arrvar1": [1, 2, 3, 4, 5],
    "vardata2": {
      "a": 10,
      "b": 20.1
    }
  },
  "references": [
    { "path": "../../out/export/Core", "uuid":"123123123213", "name": "Core.module.json" },
    { "path": "../../out/export/Std", "uuid":"456456456456", "name": "Std.module.json" }
  ],
  "struct": [
  ],
  "export": {
    "moduleName": "ProjectTest2",
    "outputDir": "F:\\project\\lang\\simple_language\\out\\export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  }
}
