{
  "project":
  {
    "name": "EqBench",
    "desc": "EqBench project - equality-compare (Ceq/Cne) micro benchmark (i32/i64/f64/bool)",
    "mainVersion": 0,
    "subVersion": 0,
    "buildVersion": 1,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "EqBench.sl", "group": "core", "tag": "bench", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std"
    ],
    "replace": {
      "DEBUG": "true"
    },
    "data": {
    }
  },
  "references": [
    { "path": "../../out/export/Core", "uuid":"123123123213", "name": "Core.module.json" },
    { "path": "../../out/export/Std", "uuid":"456456456456", "name": "Std.module.json" }
  ],
  "struct": [
  ],
  "export": {
    "moduleName": "EqBench",
    "outputDir": "..\\..\\out\\export",
    "versionMain": 0,
    "versionSub": 0,
    "versionPatch": 1,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  }
}
