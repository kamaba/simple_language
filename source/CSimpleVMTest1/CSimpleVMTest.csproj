<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="CSimpleVMTest.csproj.Backup.tmp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Front\SimpleLanguageFront.csproj" />
  </ItemGroup>

  <!-- 用 CMake 构建 C VM（产物目录：csimple_lang\build\<Config>\bin）：
       Debug 构建 -> csimple_lang_dll.dll，Program.cs P/Invoke 加载的就是它
                    （VS 内构建也走这里，保证断点行号与加载的 PDB 一致）；
       Release 构建 -> csimple_lang.exe，Program.cs Release 分支进程调用的就是它 -->
  <Target Name="BuildCVM" BeforeTargets="Build">
    <PropertyGroup>
      <CVMRoot>$(MSBuildThisFileDirectory)..\..\..\csimple_lang</CVMRoot>
      <CVMConfig Condition="'$(Configuration)' == 'Release'">Release</CVMConfig>
      <CVMConfig Condition="'$(Configuration)' != 'Release'">Debug</CVMConfig>
      <CVMTarget Condition="'$(Configuration)' == 'Release'">csimple_lang</CVMTarget>
      <CVMTarget Condition="'$(Configuration)' != 'Release'">csimple_lang_dll</CVMTarget>
    </PropertyGroup>
    <Exec Command="cmake -B &quot;$(CVMRoot)\build&quot; -S &quot;$(CVMRoot)&quot;" />
    <Exec Command="cmake --build &quot;$(CVMRoot)\build&quot; --config $(CVMConfig) --target $(CVMTarget)" />
  </Target>

</Project>
