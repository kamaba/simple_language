<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Front\SimpleLanguageFront.csproj" />
  </ItemGroup>

  <!-- Pre-build: compile C VM (csimple_lang) via CMake -->
  <Target Name="BuildCVM" BeforeTargets="Build">
    <PropertyGroup>
      <CVMRoot>$(MSBuildThisFileDirectory)..\..\..\csimple_lang</CVMRoot>
    </PropertyGroup>
    <!-- Always run cmake configure (fast if unchanged, reconfigures if CMakeLists.txt changed) -->
    <Exec Command="cmake -B &quot;$(CVMRoot)\build&quot; -S &quot;$(CVMRoot)&quot;" />
    <Exec Command="cmake --build &quot;$(CVMRoot)\build&quot; --config Debug" />
  </Target>

</Project>
