


public class Data.Tree
{
    public enum ETreeEtype
    {
        None = 0
        BinaryTree
        FourForkTree
        EightForkTree
    }
    public Node root = null;

    public static Tree Create( ETreeEtype te )
    {
        if( te == ETreeEtype.BinaryTree )
        {
            ret Tree()
        }
        ret null
    }
}