{
  "project":
  {
    "name": "Std",
    "desc": "Standard library module",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "Container/IList.sl", "group": "std", "tag": "io", "ignore": false, "priority": 0 },
      { "path": "Container/IMap.sl", "group": "std", "tag": "io", "ignore": false, "priority": 0 },
      { "path": "Container/List.sl", "group": "std", "tag": "io", "ignore": false, "priority": 0 },
      { "path": "Container/Map.sl", "group": "std", "tag": "io", "ignore": false, "priority": 0 },
      { "path": "IO/Console.sl", "group": "std", "tag": "io", "ignore": false, "priority": 0 },
      { "path": "IO/Directory.sl", "group": "std", "tag": "io", "ignore": false, "priority": 0 },
      { "path": "IO/File.sl", "group": "std", "tag": "io", "ignore": false, "priority": 0 },
      { "path": "Text/Csv.sl", "group": "std", "tag": "text", "ignore": false, "priority": 0 },
      { "path": "Text/Json.sl", "group": "std", "tag": "text", "ignore": false, "priority": 0 },
      { "path": "Text/Json5.sl", "group": "std", "tag": "text", "ignore": false, "priority": 0 },
      { "path": "Text/StringBuffer.sl", "group": "std", "tag": "text", "ignore": false, "priority": 0 },
      { "path": "Text/Xml.sl", "group": "std", "tag": "text", "ignore": false, "priority": 0 },
      { "path": "OS/DateTime.sl", "group": "std", "tag": "os", "ignore": false, "priority": 0 },
      { "path": "OS/Times.sl", "group": "std", "tag": "os", "ignore": false, "priority": 0 },
      { "path": "Net/HttpClient.sl", "group": "std", "tag": "net", "ignore": false, "priority": 0 },
      { "path": "Net/IpProtocal.sl", "group": "std", "tag": "net", "ignore": false, "priority": 0 },
      { "path": "Net/TcpNet.sl", "group": "std", "tag": "net", "ignore": false, "priority": 0 },
      { "path": "Net/UdpNet.sl", "group": "std", "tag": "net", "ignore": false, "priority": 0 },
      { "path": "Net/Uri.sl", "group": "std", "tag": "net", "ignore": false, "priority": 0 },
      { "path": "Behaviour.sl", "group": "std", "tag": "core", "ignore": false, "priority": 0 },
      { "path": "Component.sl", "group": "std", "tag": "core", "ignore": false, "priority": 0 },
      { "path": "Node.sl", "group": "std", "tag": "core", "ignore": false, "priority": 0 },
      { "path": "Data/Table.sl", "group": "std", "tag": "core", "ignore": false, "priority": 0 },
      { "path": "Data/Tree.sl", "group": "std", "tag": "core", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console",
      "Std.IO.File"
    ],
    "replace": {}
  },
  "references": [
    { "path": "../Core", "name": "Core" }
  ],
  "lib":[
    {
      "path": "../Lib/Std.dll",
      "name": "Std"
    }
  ],
  "struct": [     
      {
         "namespace": "IO", "children": 
         [
            { "class": "Console" },
            { "class": "Directory" },
            { "class": "File" }
          ]
      },
      { "namespace": "Text", "children": 
         [
             { "class": "Csv" },
             { "class": "Json" },
             { "class": "Json5" },
             { "class": "StringBuffer" },
             { "class": "Xml" }
         ]
      },
      { "namespace": "OS", "children": 
         [
            { "class": "DateTime" },
            { "class": "Time" }
        ]
      },
      { "namespace": "Net", "children": 
            [
                { "class": "HttpClient" },
                { "class": "IpProtocal" },
                { "class": "TcpNet" },
                { "class": "UdpNet" },
                { "class": "Uri" }
            ]
      },      
      { "namespace": "Data", "children": 
         [
            { "class": "Table" },
            { "class": "Tree" }
         ]
      },
      { "class": "Behaviour" },
      { "class": "Component" },
      { "class": "Node" }
  ], 
  "systemCalls": 
  [
    // ---- Bridge calls ----   
    { "name": "SystemListInit",              "returnType": "void",   "params": ["object", "Int32"], "isVariadic": false },
    { "name": "SystemListGetValueThis",      "returnType": "object", "params": ["object", "Int32"], "isVariadic": false },
    { "name": "SystemListSetValueThis",      "returnType": "void",   "params": ["object", "Int32", "object"], "isVariadic": false },
    { "name": "SystemListGetCapacity",       "returnType": "Int32",  "params": ["object"], "isVariadic": false },
    { "name": "SystemListSetCapacity",       "returnType": "void",   "params": ["object", "Int32"], "isVariadic": false },
    { "name": "SystemListRemoveValueThis",       "returnType": "void",  "params": ["object", "object"], "isVariadic": false },
    { "name": "SystemListRemoveIndexValueThis",       "returnType": "void",  "params": ["object", "Int32"], "isVariadic": false },
    { "name": "SystemListClearValueThis",       "returnType": "void",  "params": ["object"], "isVariadic": false },
    { "name": "SystemMapIndexOfKey",           "returnType": "Int32", "params": ["object", "object", "Int32"], "isVariadic": false }
  ],
  "export": {
    "moduleName": "Std",
    "outputDir": "F:\\project\\lang\\simple_language\\out\\export",
    "versionMain": 0,
    "versionSub": 1,
    "versionPatch": 0,
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  }
}
