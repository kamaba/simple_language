{
  "project":
  {
    "name": "Tensora",
    "desc": "Tensora library - AI common classes: tensor/shape/ops, autograd, activations, losses, layers (dense/conv/pool/norm/dropout), module, rnn/lstm/gru, embedding, attention/transformer, optimizers, lr schedulers, metrics, dataset, tokenizer, trainer",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "systemCalls":
  [
    // 全部能力由 SL 层实现，仅需 Core 的系统调用（SystemPrintln / SystemConvert* / SystemArray*）
    // 后续接 GPU 后端时在此登记 Tensora.xxx 扩展函数
  ],
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      // ── 基础：形状 / 数学 / 随机 / 张量 / 初始化 / 算子 ──
      // 顺序即依赖顺序：Tensor 用到 TensorMath(Math.sl) 与 Rng(Random.sl)
      { "path": "Shape.sl",   "group": "tensora", "tag": "core",  "ignore": false, "priority": 0 },
      { "path": "Math.sl",    "group": "tensora", "tag": "core",  "ignore": false, "priority": 0 },
      { "path": "Random.sl",  "group": "tensora", "tag": "core",  "ignore": false, "priority": 0 },
      { "path": "Tensor.sl",  "group": "tensora", "tag": "core",  "ignore": false, "priority": 0 },
      { "path": "Init.sl",    "group": "tensora", "tag": "core",  "ignore": false, "priority": 0 },
      { "path": "Ops.sl",     "group": "tensora", "tag": "ops",   "ignore": false, "priority": 0 },

      // ── 自动微分 / 激活 / 损失 ─────────────────────────
      { "path": "Autograd.sl",   "group": "tensora", "tag": "autograd", "ignore": false, "priority": 0 },
      { "path": "Activation.sl", "group": "tensora", "tag": "nn",       "ignore": false, "priority": 0 },
      { "path": "Loss.sl",       "group": "tensora", "tag": "nn",       "ignore": false, "priority": 0 },

      // ── 网络层 ─────────────────────────────────────────
      { "path": "Layer.sl",         "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Dense.sl",         "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Conv.sl",          "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Pooling.sl",       "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Normalization.sl", "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Dropout.sl",       "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Flatten.sl",       "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Module.sl",        "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Embedding.sl",     "group": "tensora", "tag": "nn",   "ignore": false, "priority": 0 },
      { "path": "Recurrent.sl",     "group": "tensora", "tag": "rnn",  "ignore": false, "priority": 0 },

      // ── Transformer ───────────────────────────────────
      { "path": "Attention.sl",   "group": "tensora", "tag": "attn", "ignore": false, "priority": 0 },
      { "path": "Transformer.sl", "group": "tensora", "tag": "attn", "ignore": false, "priority": 0 },
      { "path": "TransformerModel.sl", "group": "tensora", "tag": "attn", "ignore": false, "priority": 0 },

      // ── 训练：优化器 / 调度 / 指标 / 数据 / 分词 / 训练器 ──
      { "path": "Optimizer.sl", "group": "tensora", "tag": "train", "ignore": false, "priority": 0 },
      { "path": "Scheduler.sl", "group": "tensora", "tag": "train", "ignore": false, "priority": 0 },
      { "path": "Metrics.sl",   "group": "tensora", "tag": "train", "ignore": false, "priority": 0 },
      { "path": "Dataset.sl",   "group": "tensora", "tag": "data",  "ignore": false, "priority": 0 },
      { "path": "Tokenizer.sl", "group": "tensora", "tag": "data",  "ignore": false, "priority": 0 },
      { "path": "Trainer.sl",   "group": "tensora", "tag": "train", "ignore": false, "priority": 0 },

      // ── 设备抽象 ───────────────────────────────────────
      { "path": "Device.sl", "group": "tensora", "tag": "core", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console"
    ],
    "replace": {
      "DEBUG": "true"
    }
  },
  "data": {
    "defaultBatchSize": 32,
    "defaultLearningRate": 0.001
  },
  "references": [
    { "path": "../Core", "name": "Core" },
    { "path": "../Std", "name": "Std" },
    { "path": "../Math", "name": "Math" }
  ],
  "struct": [
    { "namespace": "Tensora", "children": [
      { "class": "Shape" },
      { "class": "Tensor" },
      { "class": "TensorMath" },
      { "class": "Rng" },
      { "class": "Init" },
      { "class": "Ops" },
      { "class": "Variable" },
      { "class": "Graph" },
      { "class": "EActivation" },
      { "class": "Activation" },
      { "class": "Loss" },
      { "class": "Layer" },
      { "class": "Dense" },
      { "class": "Conv2D" },
      { "class": "MaxPool2D" },
      { "class": "AvgPool2D" },
      { "class": "BatchNorm" },
      { "class": "LayerNorm" },
      { "class": "Dropout" },
      { "class": "Flatten" },
      { "class": "Module" },
      { "class": "Sequential" },
      { "class": "Embedding" },
      { "class": "RNNCell" },
      { "class": "LSTMCell" },
      { "class": "GRUCell" },
      { "class": "RNN" },
      { "class": "Attention" },
      { "class": "MultiHeadAttention" },
      { "class": "PositionalEncoding" },
      { "class": "TransformerBlock" },
      { "class": "Transformer" },
      { "class": "SeqPool" },
      { "class": "TransformerClassifier" },
      { "class": "Optimizer" },
      { "class": "SGD" },
      { "class": "Adam" },
      { "class": "AdamW" },
      { "class": "RMSProp" },
      { "class": "Adagrad" },
      { "class": "LRScheduler" },
      { "class": "StepLR" },
      { "class": "ExponentialLR" },
      { "class": "CosineLR" },
      { "class": "WarmupLR" },
      { "class": "ReduceLROnPlateau" },
      { "class": "Metrics" },
      { "class": "Batch" },
      { "class": "Dataset" },
      { "class": "DataLoader" },
      { "class": "Normalizer" },
      { "class": "Vocab" },
      { "class": "Tokenizer" },
      { "class": "History" },
      { "class": "Trainer" },
      { "class": "EDeviceKind" },
      { "class": "Device" }
    ]}
  ],
  "export": {
    "moduleName": "Tensora",
    "outputDir": "F:\\project\\lang\\simple_language\\out\\export",
    "versionMain": 1,
    "versionSub": 0,
    "versionPatch": 0,
    "includeMetadata": true,
    // Front 调试文本实际目录：{export.outputDir}/{export.moduleName}/DebugCode/
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  }
}
