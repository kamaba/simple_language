{
  "project":
  {
    "name": "Math",
    "desc": "Math library module - Math(Float64) / Mathf(Float32) / Mathh(Float16) + vectors, matrices, quaternion, big numbers",
    "mainVersion": 0,
    "subVersion": 2,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  // FFI 导入表（jsonc "dllImports" 段）。"static" 非空（静态注册名）时 cvm 加载
  // 模块即预载该库并注册进 FFI.StaticLibrary，@DllStaticImport("math_lib",
  // "mathd_sin") 静态调用点由编译期发射 opcode 118 直调绑定表（无 wrapper 委托
  // 转发开销，sig 从函数签名自动推导为短名 f64/f32），绑定失败回退 SL fallback
  // 本体兜底。"alias" 仍供 @DllImport 三参形式按别名解析 path（原样透传，运行时
  // 相对进程 CWD 解析，CWD = 测试工程目录时，../../ 即 simple_language 根）。
  // Mathh.sl 以 Float32 为中间精度复用 Mathf，无需单独声明。
  "dllImports":
  [
    { "path": "../../out/export/Math/math_lib.dll", "name": "math_lib", "alias": "math_lib", "static": "math_lib" }
  ],
  // vmDlls 构建规则：导出 Math 时，Front 用 MSBuild 编译 project 指向的 VS 工程
  // （路径相对本 jsonc 所在目录），并把产出的 math_lib.dll 拷贝到与 Math.module.json 相同的
  // 目录（out/export/Math/），即上方 dllImports 别名指向的位置。C 实现位于
  // source/Front/Lib/Math/cvm_math_lib/math_lib.c（FFI 普通 C ABI：mathf_*/mathd_*），
  // 供 Mathf.sl / Mathd.sl / 矩阵类的 @DllImport 三参形式绑定调用。
  "vmDlls": [
    { "project": "../../../../project/cvm_math_lib/cvm_math_lib.vcxproj", "name": "math_lib.dll", "configuration": "Debug", "platform": "x64" }
  ],
  // systemCalls：矩阵运算下沉 cvm（SystemMethodCall）声明。cvmFunction 用
  // "DllName!symbol" 形式（DllName 须与上方 vmDlls.name 一致），cvm 加载
  // module.json 时按 vmDllImports 预载 math_lib.dll 并按符号解析派发；
  // 实现位于 cvm_math_lib/float32_3x3_vm_method_call.c（对象参数经
  // math_vm_object_bridge.h 直接读写 member_data；返回对象走 out 参数）。
  "systemCalls": [
    { "name": "SystemMathMat3Mul",          "returnType": "void",    "params": ["object", "object", "object"], "isVariadic": false, "cvmFunction": "math_lib.dll!mathvm_mat3f_mul" },
    { "name": "SystemMathMat3MulVec",       "returnType": "void",    "params": ["object", "object", "object"], "isVariadic": false, "cvmFunction": "math_lib.dll!mathvm_mat3f_mul_vec" },
    { "name": "SystemMathMat3Transpose",    "returnType": "void",    "params": ["object", "object"],           "isVariadic": false, "cvmFunction": "math_lib.dll!mathvm_mat3f_transpose" },
    { "name": "SystemMathMat3Determinant",  "returnType": "Float32", "params": ["object"],                     "isVariadic": false, "cvmFunction": "math_lib.dll!mathvm_mat3f_determinant" },
    { "name": "SystemMathMat3Inverse",       "returnType": "void",    "params": ["object", "object"],           "isVariadic": false, "cvmFunction": "math_lib.dll!mathvm_mat3f_inverse" },
    { "name": "SystemMathMat3Add",           "returnType": "void",    "params": ["object", "object", "object"], "isVariadic": false, "cvmFunction": "math_lib.dll!mathvm_mat3f_add" },
    { "name": "SystemMathMat3Eq",           "returnType": "bool",    "params": ["object", "object"],           "isVariadic": false, "cvmFunction": "math_lib.dll!mathvm_mat3f_eq" },
    { "name": "SystemMathMat3Copy",         "returnType": "void",    "params": ["object", "object"],           "isVariadic": false, "cvmFunction": "math_lib.dll!mathvm_mat3f_copy" },
    { "name": "SystemMathMat3Identity",     "returnType": "void",    "params": ["object"],                     "isVariadic": false, "cvmFunction": "math_lib.dll!mathvm_mat3f_identity" },
    { "name": "SystemMathMat3RotationX",     "returnType": "void",    "params": ["Float32", "object"],          "isVariadic": false, "cvmFunction": "math_lib.dll!mathvm_mat3f_rotation_x" },
    { "name": "SystemMathMat3RotationY",     "returnType": "void",   "params": ["Float32", "object"],          "isVariadic": false, "cvmFunction": "math_lib.dll!mathvm_mat3f_rotation_y" },
    { "name": "SystemMathMat3RotationZ",     "returnType": "void",   "params": ["Float32", "object"],          "isVariadic": false, "cvmFunction": "math_lib.dll!mathvm_mat3f_rotation_z" },
    { "name": "SystemMathMat3Scale",        "returnType": "void",    "params": ["Float32", "Float32", "object"], "isVariadic": false, "cvmFunction": "math_lib.dll!mathvm_mat3f_scale" },
    { "name": "SystemMathMat3Translation",   "returnType": "void",    "params": ["Float32", "Float32", "object"], "isVariadic": false, "cvmFunction": "math_lib.dll!mathvm_mat3f_translation" },

    // ── Float32_4x4（float32_4x4_vm_method_call.c）──────────────────
    { "name": "SystemMathMat4Mul",               "returnType": "void",    "params": ["object", "object", "object"], "isVariadic": false, "cvmFunction": "math_lib.dll!mathvm_mat4f_mul" },
    { "name": "SystemMathMat4TransformPoint",    "returnType": "void",    "params": ["object", "object", "object"], "isVariadic": false, "cvmFunction": "math_lib.dll!mathvm_mat4f_transform_point" },
