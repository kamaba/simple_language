{
  "project":
  {
    "name": "Math",
    "desc": "Math library module - Math(Float64) / Mathf(Float32) / Mathh(Float16) + vectors, matrices, quaternion, big numbers",
    "mainVersion": 0,
    "subVersion": 2,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  "systemCalls":
  [
    // Math.sl  -> SystemCallExternalFunction("Mathd.xxx", ...)  (double，需 MathNativeImpl 注册)
    // Mathf.sl -> SystemCallExternalFunction("Math.xxx", ...)   (float，MathNativeImpl 已注册)
    // Mathh.sl -> 以 Float32 为中间精度，复用 Mathf
  ],
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      // ── 数学函数库（按精度分组）──────────────────────
      { "path": "Mathd.sl", "group": "math", "tag": "mathd", "ignore": false, "priority": 0 },
      { "path": "Mathf.sl", "group": "math", "tag": "mathf", "ignore": false, "priority": 0 },
      { "path": "Mathh.sl", "group": "math", "tag": "mathh", "ignore": false, "priority": 0 },

      // ── 大数 ─────────────────────────────────────────
      { "path": "BigNumber.sl",  "group": "math", "tag": "bignum", "ignore": true, "priority": 0 },
      { "path": "BigDecimal.sl", "group": "math", "tag": "bignum", "ignore": true, "priority": 0 },
      { "path": "Factor.sl",     "group": "math", "tag": "bignum", "ignore": true, "priority": 0 },

      // ── 向量 / 矩阵：Float32 ─────────────────────────
      { "path": "Int32_2.sl",     "group": "math", "tag": "vec", "ignore": true,  "priority": 0 },
      { "path": "Float32_2.sl",   "group": "math", "tag": "vec", "ignore": false, "priority": 0 },
      { "path": "Float32_3.sl",   "group": "math", "tag": "vec", "ignore": true,  "priority": 0 },
      { "path": "Float32_4.sl",   "group": "math", "tag": "vec", "ignore": true,  "priority": 0 },
      { "path": "Float32_3x3.sl", "group": "math", "tag": "mat", "ignore": true,  "priority": 0 },
      { "path": "Float32_4x4.sl", "group": "math", "tag": "mat", "ignore": true,  "priority": 0 },

      // ── 向量 / 矩阵：Float16 ─────────────────────────
      { "path": "Float16_2.sl",   "group": "math", "tag": "vec", "ignore": true, "priority": 0 },
      { "path": "Float16_3.sl",   "group": "math", "tag": "vec", "ignore": true, "priority": 0 },
      { "path": "Float16_4.sl",   "group": "math", "tag": "vec", "ignore": true, "priority": 0 },
      { "path": "Float16_3x3.sl", "group": "math", "tag": "mat", "ignore": true, "priority": 0 },
      { "path": "Float16_4x4.sl", "group": "math", "tag": "mat", "ignore": true, "priority": 0 },

      // ── 向量 / 矩阵：Float64 ─────────────────────────
      { "path": "Float64_2.sl",   "group": "math", "tag": "vec", "ignore": true, "priority": 0 },
      { "path": "Float64_3.sl",   "group": "math", "tag": "vec", "ignore": true, "priority": 0 },
      { "path": "Float64_4.sl",   "group": "math", "tag": "vec", "ignore": true, "priority": 0 },
      { "path": "Float64_3x3.sl", "group": "math", "tag": "mat", "ignore": true, "priority": 0 },
      { "path": "Float64_4x4.sl", "group": "math", "tag": "mat", "ignore": true, "priority": 0 },

      // ── 其他 ─────────────────────────────────────────
      { "path": "Quaternion.sl", "group": "math", "tag": "quat", "ignore": true, "priority": 0 },
      { "path": "Matrix.sl",     "group": "math", "tag": "mat",  "ignore": true, "priority": 0 },
      { "path": "Rect.sl",       "group": "math", "tag": "rect", "ignore": true, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
      "Std.Console"
    ],
    "replace": {
      "DEBUG": "true"
    }
  },
  "data": {
    "var1": 12,
    "arrvar1": [1, 2, 3, 4, 5],
    "vardata2": {
      "a": 10,
      "b": 20.1
    }
  },
  "references": [
    { "path": "../Core", "name": "Core" }
  ],
  "struct": [
    { "namespace": "Math", "children": [
      { "class": "Mathd" },
      { "class": "Mathf" },
      { "class": "Mathh" },
      { "class": "BigNumber" },
      { "class": "BigDecimal" },
      { "class": "Factor" },
      { "class": "Int32_2" },
      { "class": "Float16_2" },
      { "class": "Float16_3" },
      { "class": "Float16_4" },
      { "class": "Float16_3x3" },
      { "class": "Float16_4x4" },
      { "class": "Float32_2" },
      { "class": "Float32_3" },
      { "class": "Float32_4" },
      { "class": "Float32_3x3" },
      { "class": "Float32_4x4" },
      { "class": "Float64_2" },
      { "class": "Float64_3" },
      { "class": "Float64_4" },
      { "class": "Float64_3x3" },
      { "class": "Float64_4x4" },
      { "class": "Quaternion" },
      { "class": "Matrix" },
      { "class": "Rect" }
    ]}
  ],
  "export": {
    "moduleName": "Math",
    "outputDir": "F:\\project\\lang\\simple_language\\out\\export",
    "nativeDll": "MathNativeImpl.dll",
    "versionMain": 1,
    "versionSub": 0,
    "versionPatch": 0,
    "includeMetadata": true,
    // Front 调试文本实际目录：{export.outputDir}/{export.moduleName}/DebugCode/；以下 outputDir 仅兼容旧字段，可为空。
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  }
}
