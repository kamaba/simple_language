{
  "project":
  {
    "name": "SLMysql",
    "desc": "MySQL client library module - namespace SL: Mysql (entry + native bindings) / MysqlConnection / MysqlCursor / MysqlRow, backed by sl_mysql_lib.dll (MySQL Connector/C)",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0,
    "buildSubVersion": 0
  },
  "source": {
    "root": "."
  },
  // FFI 导入表（jsonc "dllImports" 段）。"static" 非空（静态注册名）时 cvm 加载
  // SL 模块即预载该库并注册进 FFI.StaticLibrary，@DllStaticImport("sl_mysql_lib",
  // "slm_query") 静态调用点由编译期发射 opcode 118 直调绑定表（无 wrapper 委托
  // 转发开销，sig 从函数签名自动推导：string->utf8 / Int64->i64 / Int32->i32 /
  // bool->bool / void->void）。绑定失败（库未注册 / 符号缺失）时回退 SL 函数体兜底。
  // "alias" 仍供 @DllImport 三参形式按别名解析 path（原样透传，运行时相对进程
  // CWD 解析）。
  "dllImports":
  [
    { "path": "../../out/export/SLMysql/sl_mysql_lib.dll", "name": "sl_mysql_lib", "alias": "sl_mysql_lib", "static": "sl_mysql_lib" }
  ],
  // vmDlls 构建规则：导出 SL 模块时，Front 用 MSBuild 编译 project 指向的 VS 工程
  // （路径相对本 jsonc 所在目录），并把产出的 sl_mysql_lib.dll 拷贝到与
  // SLMysql.module.json 相同的目录（out/export/SLMysql/），即上方 dllImports
  // 别名指向的位置。
  // C 实现位于 source/Front/Lib/SLMysql/cvm_sl_mysql_lib/sl_mysql_lib.c
  // （FFI 普通 C ABI：slm_*），底层静态链接官方 MySQL Connector/C 6.1.11
  // （同目录 mysqlclient/lib/vs14/mysqlclient.lib），因此产物 DLL 自包含，
  // 不依赖外部 libmysql.dll。
  "vmDlls": [
    { "project": "../../../../project/cvm_sl_mysql_lib/cvm_sl_mysql_lib.vcxproj", "name": "sl_mysql_lib.dll", "configuration": "Debug", "platform": "x64" }
  ],
  // systemCalls：本模块全部能力走 @DllStaticImport 静态绑定直调，不下沉 cvm
  // SystemMethodCall，故留空。
  "systemCalls": [],
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "SLMysql.sl", "group": "mysql", "tag": "db", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [
    ],
    "replace": {
      "DEBUG": "true"
    }
  },
  "data": {
  },
  "references": [
    // Tuple / List / Array / string 等来自 Core
    { "path": "../Core", "name": "Core" }
  ],
  "struct": [
    { "namespace": "SL", "children": [
      { "class": "Mysql" },
      { "class": "MysqlConnection" },
      { "class": "MysqlCursor" },
      { "class": "MysqlRow" }
    ]}
  ],
  "export": {
    "moduleName": "SLMysql",
    "outputDir": "F:\\project\\lang\\simple_language\\out\\export",
    "versionMain": 1,
    "versionSub": 0,
    "versionPatch": 0,
    "includeMetadata": true,
    // Front 调试文本实际目录：{export.outputDir}/{export.moduleName}/DebugCode/；以下 outputDir 仅兼容旧字段，可为空。
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  }
}
