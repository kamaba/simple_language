<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ApplicationIcon />
    <StartupObject>SimpleLanguage.Program</StartupObject>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
    <IncludeSymbols>True</IncludeSymbols>
    <IsPublishable>False</IsPublishable>
    <FileUpgradeFlags>40</FileUpgradeFlags>
    <UpgradeBackupLocation>D:\project\dotnet\lang\simple_language\Backup\</UpgradeBackupLocation>
    <OldToolsVersion>2.0</OldToolsVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE;EditorMode</DefineConstants>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Optimize>False</Optimize>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>False</Optimize>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="source\**" />
    <Compile Remove="tools\**" />
    <EmbeddedResource Remove="source\**" />
    <EmbeddedResource Remove="tools\**" />
    <None Remove="source\**" />
    <None Remove="tools\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Log\ErrorDefinitions.csv" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Log\ErrorDefinitions.csv" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="libLLVM" Version="21.1.8" />
    <PackageReference Include="libLLVM.runtime.win-x64" Version="21.1.8" />
    <PackageReference Include="swigged.llvm" Version="70.0.1" />
    <PackageReference Include="LLVMSharp" Version="20.1.2" />
    <PackageReference Include="System.Diagnostics.Debug" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Log\SimpleLanguageLog.csproj" />
  </ItemGroup>
</Project>