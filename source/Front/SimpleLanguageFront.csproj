<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ApplicationIcon />
    <StartupObject>SimpleLanguage.Program</StartupObject>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
    <IncludeSymbols>True</IncludeSymbols>
    <IsPublishable>False</IsPublishable>
    <FileUpgradeFlags>40</FileUpgradeFlags>
    <UpgradeBackupLocation>D:\project\dotnet\lang\simple_language\Backup\</UpgradeBackupLocation>
    <OldToolsVersion>2.0</OldToolsVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE;EditorMode</DefineConstants>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Optimize>False</Optimize>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>False</Optimize>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="source\IR\Lib\新文件夹\**" />
    <Compile Remove="source\MakeBin\**" />
    <EmbeddedResource Remove="source\IR\Lib\新文件夹\**" />
    <EmbeddedResource Remove="source\MakeBin\**" />
    <None Remove="source\IR\Lib\新文件夹\**" />
    <None Remove="source\MakeBin\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="libLLVM" Version="15.0.0" />
    <PackageReference Include="libLLVM.runtime.win-x64" Version="20.1.2" />
    <PackageReference Include="swigged.llvm" Version="70.0.1" />
    <PackageReference Include="System.Diagnostics.Debug" Version="4.3.0" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="source\Export\ExportJavascriptCode\" />
    <Folder Include="source\Export\ExportTypescriptCode\" />
    <Folder Include="source\Export\ExportCSharpCode\" />
    <Folder Include="source\Export\GenerateMonoIL\" />
    <Folder Include="source\Export\ExportCPlusCode\" />
    <Folder Include="source\OtherLanguage\CSharp\Statements\" />
    <Folder Include="source\VM\NewObject\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="tools\ExtractLogs\ExtractLogs.csproj" />
    <None Include="tools\ScanSwiggedApi\ScanSwiggedApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lib\SimpleLanuageLib.csproj" />
    <ProjectReference Include="..\Log\SimpleLanguageLog.csproj" />
  </ItemGroup>
</Project>