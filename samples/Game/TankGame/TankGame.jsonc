{
  "project": {
    "name": "TankGame",
    "desc": "最简单的坦克游戏（cmd 回合式）",
    "mainVersion": 0,
    "subVersion": 1,
    "buildVersion": 0
  },
  "source": {
    "root": "."
  },
  "compile": {
    "optimize": false,
    "target": "x64",
    "debug": true,
    "isUseForceSemiColonInLineEnd": true,
    "isForceUseClassKey": false,
    "isSupportDoublePlus": false,
    "requireSameNumericTypes": false
  },
  "compileFiles": {
    "files": [
      { "path": "TankGame.sl", "group": "game", "tag": "all", "ignore": false, "priority": 0 }
    ]
  },
  "compileFilter": {
    "isAllGroup": true,
    "isAllTag": true
  },
  "global": {
    "imports": [],
    "replace": {}
  },
  "references": [
    { "path": "../../../source/Front/Lib/Core", "name": "Core" }
  ],
  "export": {
    "moduleName": "TankGame",
    "outputDir": "F:\\project\\lang\\simple_language\\out\\export",
    "includeMetadata": true,
    "debugText": {
      "outputDir": "",
      "code": true,
      "token": true,
      "node": true,
      "file": true,
      "meta": true,
      "ir": true
    }
  }
}
